 BO je neovlašćeno koristila mobilni telefon i vodila paralelni spisak birača po rednom broju iz biračkog spiska. Naveli članovi BO (lista Usame Zukorlić – Ujedinjeni za pravdu i Koalicija NADA)."},{"v":"Ostalo","t":"Uprkos upozorenju, članica BO je nastavila da koristi mobilni telefon, a članovi za biračkim spiskom su glasno izgovarali redni broj i ime i prezime birača. Naveo član BO (lista Usame Zukorlić – Ujedinjeni za pravdu)."}],"zap":{"voters":924,"out":498,"valid":484,"invalid":14,"lists":{"1":215,"2":33,"3":4,"4":11,"5":4,"6":7,"7":178,"8":3,"9":0,"10":1,"11":2,"12":8,"13":0,"14":16,"15":2,"16":0,"17":0,"18":0}},"link":"https://www.rik.parlament.gov.rs/extfile/sr/election_results/657f6ec1f1c80/%40%D0%9F%D0%904_83f59a304fe9aacb49a52f27f19a3bc3.pdf"},"217866":{"sha":"55fe497049b2ed37aeb6b5829f10ae620ca5147439659b1d663b4cbe0a649aa1","n":11,"at":"23.10. 20:12","p":[{"v":"Birački spisak","t":"Član BO Ivan Krošlak navodi da je član komisije Goran Marjanović sedeo iza članova kod biračkih spiskova i vodio paralelni birački spisak; kad je zamoljen da ode, vratio se na nagovor Duška Ilića i nastavio."},{"v":"Prekid glasanja","t":"Ivan Krošlak navodi da je glasanje prekinuto od 7:52 do 8:18 (u zapisniku: prekid 26 minuta zbog korišćenja mobilnih telefona)."},{"v":"Agitacija / pritisak na birače","t":"Ivan Krošlak navodi da je Duško Ilić neobično agresivno ubedio članove komisije da se glasanje nastavi i da na upozorenja odgovara da on u Magliću može šta hoće."},{"v":"Red i mir na BM","t":"Ivan Krošlak navodi da Goran Marjanović i Duško Ilić stalno koriste mobilni telefon na biračkom mestu."},{"v":"Birački spisak","t":"Ivan Krošlak navodi da članovi na kontroli biračkog spiska (Sergej Antonić, Marica Stojanović) naglas govore redne brojeve izašlih birača Goranu Marjanoviću, koji ih telefonom šalje dalje."},{"v":"Glasanje van BM","t":"Ivan Krošlak navodi da komisija pri glasanju van BM nije koristila UV lampu i sprej za proveru identiteta, a listići glasača koji su glasali kod kuće ubačeni su u kutiju i uračunati u rezultat."}],"zap":{"voters":909,"out":663,"valid":628,"invalid":32,"lists":{"1":337,"2":56,"3":17,"4":11,"5":29,"6":7,"7":110,"8":1,"9":1,"10":1,"11":4,"12":6,"13":0,"14":43,"15":1,"16":4,"17":0,"18":0}},"link":"https://www.rik.parlament.gov.rs/extfile/sr/election_results/657f88c2d3766/%40PA11_d4da73609054e12af957b713b24d02fe.pdf"}},"47":{"217878":{"sha":"0e758b5c65b396769335dd86b3f1602ab9669bb4d2e6f744d90d8cbb5f526708","n":4,"at":"23.10. 20:10","p":[{"v":"Birački spisak","t":"Oko 16 h birač nije mogao da glasa jer je druga osoba sa istim imenom i prezimenom već bila upisana (potpisana) na njegovom mestu, jer nije proveravan JMBG; birač je otišao bez glasanja, zastoj 10 minuta. Navela članica BO (SPN)."}],"zap":{"voters":1459,"out":993,"valid":962,"invalid":31,"lists":{"1":491,"2":88,"3":16,"4":27,"5":39,"6":4,"7":210,"8":4,"9":0,"10":2,"11":7,"12":6,"13":0,"14":62,"15":1,"16":4,"17":1,"18":0}},"link":"https://www.rik.parlament.gov.rs/extfile/sr/election_results/657fb4d6c71db/%40%D0%9F%D0%904_99bb65ef8dd8b88881f3d8bfcfdf0dff.pdf"}},"5":{"211761":{"sha":"12e262a938d181e9ec12306983596cc2dcf6c02600714902d518eb25f710ffea","n":55,"at":"23.10. 20:10","p":[],"zap":{"voters":1555,"out":868,"valid":853,"invalid":15,"lists":{"1":311,"2":39,"3":8,"4":21,"5":40,"6":0,"7":331,"8":1,"9":0,"10":3,"11":8,"12":12,"13":0,"14":72,"15":2,"16":1,"17":4,"18":0}},"link":"https://www.rik.parlament.gov.rs/extfile/sr/election_results/657fb8f74121e/%4055%20%D0%B7%D0%B0%D0%BF%D0%B8%D1%81%D0%BD%D0%B8%D0%BA%20%D0%BE%20%D1%80%D0%B0%D0%B4%D1%83%20%D0%91%D0%9E%20%D0%B7%D0%B0%20%D0%BF%D0%B0%D1%80%D0%BB%D0%B0%D0%BC%D0%B5%D0%BD%D1%82%20%D0%93%D0%9E%20%D0%97%D0%B5%D0%BC%D1%83%D0%BD_a703d4e5e02a11942ca5bac7174ba153.pdf"}},"12":{"213645":{"sha":"3a6e170f167534d59aa443830c74f15aad1007392834234fdbcaa84af9c3c4e1","n":15,"at":"23.10. 20:12","p":[],"zap":{"voters":2811,"out":1365,"valid":1330,"invalid":27,"lists":{"1":512,"2":64,"3":10,"4":34,"5":101,"6":1,"7":4